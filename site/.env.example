# Wzór pliku ze zmiennymi środowiskowymi.
# Skopiuj jako `.env.local` (nie trafia do repozytorium) albo ustaw te wartości
# w panelu hostingu.

# Tryb podglądu: "1" prosi wyszukiwarki, żeby NIE indeksowały strony.
# Ustawiaj wyłącznie na adresach tymczasowych (np. *.vercel.app), zanim ruszy
# letfit.pl. Odczytywane przy budowaniu — po zmianie potrzebny nowy deploy.
# Puste albo brak wpisu = strona normalna, widoczna dla Google.
LETFIT_PREVIEW=1
